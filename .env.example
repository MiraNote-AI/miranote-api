# Shared secrets for the beta deployment. Copy to .env and fill in.
# .env is gitignored; never commit a real token.
#
# BETA_TOKENS is comma-separated so tokens can be rotated without cutting
# every tester off at once: add the new one, ship a build carrying it, then
# drop the old one. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BETA_TOKENS=

# Signed-in AI requests (ai_auth.py, api #95 step 3). The AI services verify
# our access tokens with the accounts service's JWKS and meter paid calls
# through its internal /usage routes.
# ACCOUNTS_URL=http://127.0.0.1:8007
# Same value as ACCOUNTS_INTERNAL_SECRET in poc/accounts/.env. Without it
# every signed-in call answers 503 (metered ones reserve, the others check
# that the account still exists); the beta token does not need it.
ACCOUNTS_INTERNAL_SECRET=
# 0 refuses the beta token everywhere except /mood (until App Attest).
# ACCEPT_BETA_TOKENS=1
