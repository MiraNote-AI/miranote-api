# Photo collections (port 8006). Copy to .env and fill in; .env is gitignored.
# Same DashScope (Aliyun Bailian, Beijing) key as poc/voice-to-text.
# The three move together: key, URL and model must belong to one provider.
LLM_API_KEY=your-dashscope-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash
#
# Optional overrides of the request shape per call (see README.md):
# PHOTO_CALL_A_MODE=thinking_stream   # or json_object
# PHOTO_CALL_B_MODE=json_schema       # or json_object
#
# The beta token is NOT here: it is BETA_TOKENS in the repo-root .env.
