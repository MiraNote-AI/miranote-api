# Copy to .env (gitignored) and fill in. Never commit a real URL.
#
# Postgres URL, required. Neon's pooled connection string works as copied
# (postgresql://...-pooler...?sslmode=require&channel_binding=require);
# db.py turns sslmode into asyncpg's ssl and drops channel_binding.
DATABASE_URL=

# EC P-256 private key (PEM) that signs our access tokens, required. Make one:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# and paste it here in double quotes (newlines kept, or written as \n).
ACCOUNTS_SIGNING_KEY=
# After a rotation: the old key's public PEM, for one hour (README, Keys).
ACCOUNTS_PREVIOUS_PUBLIC_KEY=

# Sign in with Apple; the defaults are the app's bundle id and the
# personal team (design 3.4).
# APPLE_BUNDLE_ID=ai.miranote.app
# APPLE_TEAM_ID=W7U365VR4U
