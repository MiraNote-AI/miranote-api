# Vertex AI. Still required: /describe, /stylize and /border run on Gemini, and
# so does the bbox detector inside a prompted /cutout. Authentication is
# Application Default Credentials (gcloud auth application-default login), not a
# key in this file.
PROJECT_ID=your-gcp-project-id
# config.MODEL_ID is served only from the global endpoint; us-central1 returns
# 404 NOT_FOUND for it. This also applies to the Gemini rollback path.
LOCATION=global

# Aliyun Bailian (DashScope). /generate runs here: z-image-turbo for the image
# and qwen-turbo for the prompt expansion.
#
# This is the SAME account and the SAME key that poc/voice-to-text uses for
# transcript correction -- one key covers both services.
#
# Without it every /generate answers 502 naming this variable. Everything else
# (cutout, stylize, border, describe) keeps working.
DASHSCOPE_API_KEY=your-dashscope-api-key

# Optional. Switches all three /generate modes to one model, without editing
# config.py. Accepts any key of config.IMAGE_MODELS, and config.MODEL_ID, which
# is the rollback off DashScope:
#   IMAGE_MODEL=gemini-3.1-flash-lite-image
# An unknown value fails at startup rather than on the first paid call.
# IMAGE_MODEL=

# Optional. Switches /stylize to another Gemini image model without editing
# config.py. gemini-2.5-flash-image is the rollback. Unlike IMAGE_MODEL this is
# not checked at startup, so a typo surfaces as a Vertex 404 on the first call.
# STYLE_MODEL=
