# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=medium

# LLM for post-correction. Any OpenAI-compatible provider works.
# Optional: leave LLM_API_KEY empty to disable correction and return raw
# Whisper output.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# Example provider swaps. Set all three together: a key from one provider
# against another's base URL is the failure this warns about -- the beta ran
# for weeks with a DeepSeek key pointed at the Gemini URL, and every correction
# failed silently behind a 200 (see issue #73).
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-flash
#   Moonshot:  LLM_BASE_URL=https://api.moonshot.cn/v1    LLM_MODEL=moonshot-v1-8k
#   OpenAI:    LLM_BASE_URL=https://api.openai.com/v1     LLM_MODEL=gpt-4o-mini
